<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Entitlements for a hardened-runtime build (the Developer ID path, tools/release/sign_app.sh).
     Under the hardened runtime an app may only use the microphone (here: the audio interface's inputs)
     if it declares this. Not used for the default self-signed build, which runs without the hardened
     runtime (docs/RELEASING.md, "Signing"). -->
<plist version="1.0">
<dict>
    <key>com.apple.security.device.audio-input</key>
    <true/>
</dict>
</plist>
