# CMake build output (the dev build, and the release script's universal build)
/build
/build-release

# Downloaded pinned frameworks (tools/fetch_deps.sh) and release outputs (tools/release/release.sh)
/build-deps
/dist

# User-supplied captures and IRs (never committed; see README)
/models
/irs

# Audio files, except committed test fixtures
*.wav
!tests/fixtures/**/*.wav
!content/**/*.wav

__pycache__/
.DS_Store

# Test proof output when ampsim_tests runs without --proof-dir
/proof

# Agent worktrees (Claude Code)
/.claude/
